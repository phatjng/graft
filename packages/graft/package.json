{
  "name": "@phatjng/graft",
  "version": "0.0.0",
  "description": "React metaframework built on Vite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phatjng/graft.git",
    "directory": "packages/graft"
  },
  "bin": {
    "graft": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "import": "./dist/vercel.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phatjng/graft-node": "workspace:*",
    "@phatjng/graft-router": "workspace:*",
    "@phatjng/graft-server": "workspace:*",
    "@phatjng/graft-vercel": "workspace:*",
    "@phatjng/graft-vite": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "vite": "^8.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0"
  }
}
