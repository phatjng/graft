{
  "name": "graft-monorepo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phatjng/graft.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --filter \"./packages/*\" run build",
    "test": "vitest run",
    "typecheck": "pnpm build && pnpm --recursive run typecheck && tsc --noEmit -p test",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@phatjng/graft": "workspace:*",
    "@phatjng/graft-router": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.70.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0"
}
